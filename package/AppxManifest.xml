<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity Name="Blitz.WidBarAiUsage" Publisher="CN=blitz" Version="1.2.1.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AI Usage - WidBar Widget</DisplayName>
    <PublisherDisplayName>blitz</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.5.1.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="WidBar.AiUsage.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AI Usage Widget"
        Description="Plan limits and spend for your AI coding tools, for WidBar."
        BackgroundColor="transparent"
        Square150x150Logo="Images\MediumTile.png"
        Square44x44Logo="Images\AppIcon.png"
        AppListEntry="none">
        <uap:DefaultTile Square71x71Logo="Images\SmallTile.png" Wide310x150Logo="Images\WideTile.png" Square310x310Logo="Images\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.widbar.widget"
            Id="aiusage"
            PublicFolder="Public"
            DisplayName="AI Usage"
            Description="Plan limits and spend for your AI coding tools.">
            <uap3:Properties>
              <WidBarPluginId>com.blitz.aiusage</WidBarPluginId>
              <WidBarSdkVersion>2</WidBarSdkVersion>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
    <Application Id="System" Executable="WidBar.AiUsage.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="System Widget"
        Description="CPU, GPUs, RAM, disk and fans for WidBar."
        BackgroundColor="transparent"
        Square150x150Logo="Images\MediumTile.png"
        Square44x44Logo="Images\AppIcon.png"
        AppListEntry="none">
        <uap:DefaultTile Square71x71Logo="Images\SmallTile.png" Wide310x150Logo="Images\WideTile.png" Square310x310Logo="Images\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.widbar.widget"
            Id="system"
            PublicFolder="PublicSystem"
            DisplayName="System"
            Description="CPU, GPUs, RAM, disk and fans from LibreHardwareMonitor.">
            <uap3:Properties>
              <WidBarPluginId>com.blitz.system</WidBarPluginId>
              <WidBarSdkVersion>2</WidBarSdkVersion>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
